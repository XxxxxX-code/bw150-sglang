[start_opt] TAG=envcheck strategy=no_buffer mem_frac=0.85 ctx=262144
[start_opt] kv=bfloat16 spec_steps=3 graph_bs=64
[start_opt] EXTRA_ENV=SGLANG_USE_AITER_LINEAR_ATTN=1 SGLANG_USE_CAUSAL_CONV1D=1 SGLANG_USE_AITER_AR=1 USE_HCU_CUSTOM_ALLREDUCE=1 HIP_KERNEL_EVENT_SYSTENFENCE=1 GLIBC_TUNABLES=glibc.rtld.optional_static_tls=0x40000 HIP_KERNEL_BATCH_CEILING=100 GPU_FORCE_BLIT_COPY_SIZE=16 HSA_KERNARG_POOL_SIZE=8388608 ROC_AQL_QUEUE_SIZE=131072 GPU_MAX_HW_QUEUES=4
[start_opt] EXTRA_ARGS=--disable-radix-cache --max-running-requests 64 --max-mamba-cache-size 64
       --mamba-ssm-dtype bfloat16
       --chunked-prefill-size 32768 --max-prefill-tokens 32768
[start_opt] log -> /data/baseline/logs/server_envcheck.log
